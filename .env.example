# Opcional: variables para docker compose up. Copiar a .env (en la raíz) y completar.
# Sin este archivo el proyecto levanta igual: el pago es simulado y la importación del padrón
# termina en error. Para desarrollar, la API usa apps/api/.env.

# Pago simulado: la pantalla de pago ofrece aprobarlo o rechazarlo (decisión 138). El compose lo
# prende si no se dice otra cosa. Con 0, cada organización cobra con su MercadoPago y hacen falta
# las variables de abajo (decisión 137).
PAGO_SIMULADO=1
# Credenciales de producción de la aplicación de Setpoint en MercadoPago (Tus integraciones >
# Credenciales > Producción). La URL de redireccionamiento de la aplicación tiene que ser
# API_URL_PUBLICA + /api/mercadopago/vuelta.
MERCADOPAGO_CLIENT_ID=""
MERCADOPAGO_CLIENT_SECRET=""
# Con 1, las cuentas que se conectan reciben credenciales de prueba: solo se paga con tarjetas de prueba.
# Solo para probar: la versión publicada no la lleva y cobra de verdad.
MERCADOPAGO_PRUEBA=1
# Clave para guardar cifrados los tokens de cada organización: 32 bytes en hex.
# node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
CLAVE_TOKENS_MERCADOPAGO=""
# Dirección pública de la API (ngrok), para que lleguen el webhook y la vuelta de MercadoPago.
API_URL_PUBLICA=""
# IA: importación del padrón y resultados desde los mensajes. Sin clave, esas dos funciones terminan en error
# y los límites de abajo no se aplican.
ANTHROPIC_API_KEY=""
# Límites de la IA (docs/06-ia.md, decisión 121). Todos opcionales; estos son los valores por defecto.
# Pedidos (una subida de planilla o una lectura de mensajes) que puede hacer cada usuario por hora.
IA_PEDIDOS_POR_HORA=10
# Tope de gasto por organización en las últimas 24 horas, en dólares, calculado con los tokens de la respuesta.
# Una planilla de 77 jugadores cuesta unos US$ 0,06: con 2 alcanza para decenas de pruebas.
IA_TOPE_DIARIO_USD=2
# Precio del modelo en dólares por millón de tokens (hoy Claude Haiku 4.5). Si cambia el modelo, cambian estos.
IA_PRECIO_ENTRADA_USD_MTOK=1
IA_PRECIO_SALIDA_USD_MTOK=5
