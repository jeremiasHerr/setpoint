# Opcional: variables para docker compose up. Copiar a .env (en la raíz) y completar.
# Sin este archivo el proyecto levanta igual: el pago es simulado y la importación del padrón
# termina en error. Para desarrollar, la API usa apps/api/.env.

# Credencial de prueba de MercadoPago. Vacía, el pago es simulado (decisión 053).
MERCADOPAGO_ACCESS_TOKEN=""
# Dirección pública de la API (ngrok), para que llegue el webhook de MercadoPago.
API_URL_PUBLICA=""
# Importación del padrón con IA.
ANTHROPIC_API_KEY=""
