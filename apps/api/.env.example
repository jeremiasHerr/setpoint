DATABASE_URL="postgresql://setpoint:setpoint@localhost:5432/setpoint"
PORT=3000
JWT_SECRET="cambiar-esto"
# Mailpit del docker-compose. Sin SMTP_HOST los mails se imprimen en la consola de la API.
SMTP_HOST="localhost"
SMTP_PORT=1025
# Solo para un SMTP real con usuario y contraseña.
SMTP_USER=""
SMTP_PASS=""
# En la versión publicada los mails salen por la API HTTP de Resend (decisión 086).
# Si está cargada, se usa en lugar del SMTP.
RESEND_API_KEY=""
CORREO_REMITENTE="SetPoint <no-responder@setpoint.local>"
# Dirección de la web, para armar los links que van por mail y el de los cuadros en la app.
# Para abrirlos desde un celular, la IP de la notebook en la Wi-Fi, no localhost.
WEB_URL="http://localhost:5173"
ANTHROPIC_API_KEY=""# MercadoPago. Sin token, el pago de las inscripciones es simulado (decisión 053).
MERCADOPAGO_ACCESS_TOKEN=""
# Dirección pública de la API, para el webhook de MercadoPago (en desarrollo, la de ngrok).
API_URL_PUBLICA=""
