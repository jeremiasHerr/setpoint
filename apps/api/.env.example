DATABASE_URL="postgresql://setpoint:setpoint@localhost:5432/setpoint"
PORT=3000
JWT_SECRET="cambiar-esto"
# Mailpit del docker-compose. Sin SMTP_HOST los mails se imprimen en la consola de la API.
SMTP_HOST="localhost"
SMTP_PORT=1025
# Solo para un SMTP real con usuario y contraseña.
SMTP_USER=""
SMTP_PASS=""
# En la versión publicada los mails salen por la API HTTP de Resend (decisión 086).
# Si está cargada, se usa en lugar del SMTP.
RESEND_API_KEY=""
CORREO_REMITENTE="Setpoint <no-responder@setpoint.local>"
# Dirección de la web, para armar los links que van por mail y el de los cuadros en la app.
# Para abrirlos desde un celular, la IP de la notebook en la Wi-Fi, no localhost.
WEB_URL="http://localhost:5173"
ANTHROPIC_API_KEY=""
# Pago simulado: la pantalla de pago ofrece aprobarlo o rechazarlo (decisión 138). Sin esta
# variable, cada organización cobra con su MercadoPago y hacen falta las de abajo (decisión 137).
PAGO_SIMULADO=1
# Credenciales de producción de la aplicación de Setpoint en MercadoPago. La URL de
# redireccionamiento de la aplicación tiene que ser API_URL_PUBLICA + /api/mercadopago/vuelta.
MERCADOPAGO_CLIENT_ID=""
MERCADOPAGO_CLIENT_SECRET=""
# Con 1, las cuentas que se conectan reciben credenciales de prueba: solo se paga con tarjetas de prueba.
# Solo para probar: la versión publicada no la lleva y cobra de verdad.
MERCADOPAGO_PRUEBA=1
# Clave para guardar cifrados los tokens de cada organización: 32 bytes en hex.
# node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
CLAVE_TOKENS_MERCADOPAGO=""
# Dirección pública de la API, para el webhook y la vuelta de MercadoPago (en desarrollo, la de ngrok).
API_URL_PUBLICA=""
